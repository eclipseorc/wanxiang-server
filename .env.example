# Copy this file to .env and set a unique strong administrator password.
# All three server processes load this file from the repository root.
DB_PATH=./data/wanxiang.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-unique-password
# 安卓设备端 HTTP API（换票）
WEB_ADDR=:9001
# 管理后台 HTTP API + 静态页面
ADMIN_ADDR=:9002
# WebSocket 转发（设备 + 管理端）
WS_ADDR=:9003
# Exact browser Origin(s), comma-separated. Example: http://localhost:9002
WS_ALLOWED_ORIGINS=http://localhost:9002
WEB_DIR=./web
# Optional: enable built-in TLS for the admin and websocket listeners. Both
# values must be set together. Leave them empty when TLS is terminated by a
# reverse proxy. The web-server (device API) is plain HTTP by design.
# TLS_CERT=./certs/server.crt
# TLS_KEY=./certs/server.key
