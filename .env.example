# Copy this file to .env and set a unique strong administrator password.
# Both server processes load this file from the repository root.
DB_PATH=./data/wanxiang.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-unique-password
HTTP_ADDR=:8080
WS_ADDR=:8081
# Exact browser Origin(s), comma-separated. Example: http://localhost:8080
WS_ALLOWED_ORIGINS=http://localhost:8080
WEB_DIR=./web
